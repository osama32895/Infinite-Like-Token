<UserControl x:Class="InfiniteLikeToken.UI.Views.AgentChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0F172A">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR: Recent Chats -->
        <Border Grid.Column="0" Background="#14181D" CornerRadius="8,0,0,8" BorderBrush="#2D3748" BorderThickness="1,1,0,1" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Button Grid.Row="0" Content="+ New Chat" Command="{Binding NewChatCommand}" 
                        Background="#10B981" Foreground="White" FontWeight="Bold" Padding="10" 
                        BorderThickness="0" Cursor="Hand" Margin="0,0,0,12" FontSize="14"/>

                <ListBox Grid.Row="1" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" 
                         Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="10,8" Margin="0,0,0,4">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#2D3748"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1E232A"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
    <DataTemplate>
        <Border Background="Transparent" Padding="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📌 " Foreground="#FBBF24" FontSize="12" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding LastUpdated, StringFormat='{}{0:MMM dd, yyyy HH:mm}'}" Foreground="#9CA3AF" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📌" Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Background="Transparent" Foreground="#FBBF24" BorderThickness="0" Cursor="Hand" ToolTip="Pin / Unpin Chat" Margin="0,0,4,0" Padding="4" FontSize="12"/>
                    <Button Content="✏️" Command="{Binding DataContext.RenameChatCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Background="Transparent" Foreground="#60A5FA" BorderThickness="0" Cursor="Hand" ToolTip="Rename Chat" Margin="0,0,4,0" Padding="4" FontSize="12"/>
                    <Button Content="🗑️" Command="{Binding DataContext.DeleteSessionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Background="Transparent" Foreground="#EF4444" BorderThickness="0" Cursor="Hand" ToolTip="Delete Chat" Padding="4" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>
</ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- MAIN CHAT AREA -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <Border Grid.Row="0" Background="#1E232A" CornerRadius="0,8,0,0" Padding="14" Margin="0,0,0,14" BorderBrush="#2D3748" BorderThickness="1,1,1,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Workspace:" VerticalAlignment="Center" Foreground="#9CA3AF" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1" Text="{Binding WorkspaceFolder}" Background="#0F1318" Foreground="#E5E7EB" Padding="6" BorderBrush="#2D3748"/>
                    <Button Grid.Row="1" Grid.Column="2" Content="Browse..." Command="{Binding BrowseWorkspaceCommand}" Background="#374151" Foreground="#FFFFFF" Padding="10,6" Margin="6,0,16,0" BorderThickness="0" Cursor="Hand"/>

                    <TextBlock Grid.Column="3" Text="Routing Mode:" VerticalAlignment="Center" Foreground="#9CA3AF" Margin="0,0,8,0"/>
                    <ComboBox Grid.Column="4" ItemsSource="{Binding RoutingModes}" SelectedItem="{Binding SelectedRoutingMode}" Background="#2D3748" Foreground="#FFFFFF" Padding="6"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="#14181D" CornerRadius="0" Padding="12" BorderBrush="#2D3748" BorderThickness="1,0,1,1">
                <ScrollViewer x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,4,0,8" Padding="14" CornerRadius="8" Background="#1E232A" BorderBrush="#2D3748" BorderThickness="1">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="{Binding Role}" FontWeight="Bold" Foreground="#818CF8" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding ModelUsed}" Foreground="#10B981" FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                
                                                <!-- Copy Button (All Messages) -->
                                                <Button Content="📋" 
                                                        Command="{Binding DataContext.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent" BorderBrush="#4B5563" BorderThickness="1" Foreground="#9CA3AF" FontSize="11" Padding="6,2" Margin="0,0,6,0" Cursor="Hand" ToolTip="Copy message to clipboard" />
                                                
                                                <!-- Edit Button (User Only) -->
                                                <Button Content="✏️" 
                                                        Command="{Binding DataContext.EditMessageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                                        CommandParameter="{Binding}" 
                                                        Background="Transparent" BorderBrush="#4B5563" BorderThickness="1" Foreground="#9CA3AF" FontSize="11" Padding="6,2" Cursor="Hand" ToolTip="Edit message and reset history below it">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Role}" Value="user">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <!-- Branch Button (AI/System Only) -->
                                                <Button Content="🌿" 
                                                        Command="{Binding DataContext.BranchChatCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                                        CommandParameter="{Binding}" 
                                                        Background="Transparent" BorderBrush="#4B5563" BorderThickness="1" Foreground="#9CA3AF" FontSize="11" Padding="6,2" Cursor="Hand" Margin="5,0,0,0" ToolTip="Copy chat up to here into a new session">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Role}" Value="assistant">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Role}" Value="system">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <TextBox Text="{Binding Content, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                                 Background="Transparent" BorderThickness="0" Foreground="#E5E7EB"
                                                 FontFamily="Consolas" FontSize="13"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="2" Margin="0,12,0,0" AllowDrop="True" PreviewDragOver="InputBox_PreviewDragOver" PreviewDrop="InputBox_Drop" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Button Column -->
                    <ColumnDefinition Width="*"/>    <!-- TextBox Column -->
                    <ColumnDefinition Width="Auto"/> <!-- Send Column -->
                    <ColumnDefinition Width="Auto"/> <!-- Stop Column -->
                </Grid.ColumnDefinitions>

                <!-- Attached Image Chips Preview -->
                <ItemsControl Grid.Row="0" Grid.ColumnSpan="4" ItemsSource="{Binding PendingAttachments}" Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#2E2B42" CornerRadius="6" Padding="6,4" Margin="0,0,6,6" BorderBrush="#4B5563" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="{Binding FilePath}" Width="28" Height="28" Stretch="UniformToFill" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding FileName}" MaxWidth="160" TextTrimming="CharacterEllipsis" Foreground="#E2E8F0" FontSize="11" VerticalAlignment="Center"/>
                                    <Button Content="✕" 
                                            Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                            CommandParameter="{Binding}"
                                            Foreground="#EF4444" Background="Transparent" BorderThickness="0" Margin="6,0,0,0" Cursor="Hand" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Attach Paperclip Button -->
                <Button Grid.Row="1" Grid.Column="0" Content="📎" Command="{Binding AttachFilesCommand}"
                        Background="#374151" Foreground="#FFFFFF" FontSize="18" Padding="14,0" Margin="0,0,8,0"
                        BorderThickness="0" Cursor="Hand" ToolTip="Attach files directly"/>

                <!-- Input Text Box (Drop events moved to parent grid) -->
                <TextBox Grid.Row="1" Grid.Column="1" 
                         Text="{Binding InputMessage, UpdateSourceTrigger=PropertyChanged}" 
                         Height="60" AcceptsReturn="True" TextWrapping="Wrap"
                         Background="#1E232A" Foreground="#FFFFFF" BorderBrush="#2D3748" Padding="10" FontSize="14" PreviewKeyDown="InputBox_PreviewKeyDown" />

                <Button Grid.Row="1" Grid.Column="2" Content="Send Prompt 🚀" Command="{Binding SendMessageCommand}"
                        Background="#4F46E5" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" Padding="20,0" Margin="10,0,0,0" BorderThickness="0" Cursor="Hand"/>

                <Button Grid.Row="1" Grid.Column="3" Content="■ Stop" Command="{Binding StopGenerationCommand}"
                        Visibility="{Binding IsStreaming, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Background="#DC2626" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" Padding="18,0" Margin="8,0,0,0" BorderThickness="0" Cursor="Hand"/>
            </Grid>

            <Border Grid.Row="3" Background="#111827" CornerRadius="0,0,8,0" Padding="12,8" Margin="0,10,0,0" BorderBrush="#1F2937" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Proxy Status: " Foreground="#9CA3AF" FontSize="12"/>
                    <TextBlock Grid.Column="1" Text="{Binding ActiveEngineStatus}" Foreground="#34D399" FontSize="12" FontWeight="SemiBold"/>

                    <TextBlock Grid.Column="2" Text="Tokens Used: " Foreground="#9CA3AF" FontSize="12"/>
                    <TextBlock Grid.Column="3" Text="{Binding TotalTokensUsed, StringFormat='{}{0:N0} tokens'}" Foreground="#FBBF24" FontSize="12" FontWeight="Bold"/>

                    <TextBlock Grid.Column="4" Text="{Binding CurrentModelKeyInfo, StringFormat='Active: {0}'}" Foreground="#A78BFA" FontSize="12"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
