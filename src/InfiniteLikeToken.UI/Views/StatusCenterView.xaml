<UserControl xmlns:helpers="clr-namespace:InfiniteLikeToken.UI.Helpers" x:Class="InfiniteLikeToken.UI.Views.StatusCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0F172A">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="📊 Token &amp; Usage Status" FontSize="28" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,8"/>
            <TextBlock Text="Real-time telemetry across all API keys." FontSize="14" Foreground="#94A3B8" Margin="0,0,0,24"/>
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="#1E293B" CornerRadius="8" Padding="20" Margin="0,0,12,0" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Total Tokens Used" Foreground="#94A3B8"/>
                        <TextBlock Text="{Binding TotalTokens}" FontSize="24" FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#1E293B" CornerRadius="8" Padding="20" Margin="12,0,0,0" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Active Keys" Foreground="#94A3B8"/>
                        <TextBlock Text="{Binding ActiveKeys}" FontSize="24" FontWeight="Bold" Foreground="#38BDF8" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
            <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                     Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155" 
                     Padding="10" Margin="0,0,0,12" FontSize="14" 
                     Tag="🔍 Search providers or keys..."/>
        </StackPanel>
        
        <DataGrid helpers:DataGridStateTracker.StateId="StatusCenterViewGrid" Grid.Row="1" ItemsSource="{Binding KeyUsagesView}" AutoGenerateColumns="False" 
                  CanUserSortColumns="True" Background="#0F172A" RowBackground="#1E293B" 
                  AlternatingRowBackground="#0F1318" Foreground="#E5E7EB" 
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" 
                  HorizontalGridLinesBrush="#334155" BorderThickness="1" BorderBrush="#334155">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="*"/>
                <DataGridTextColumn Header="Nickname" Binding="{Binding KeyNickname}" Width="*"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                <DataGridTextColumn Header="Tokens Used" Binding="{Binding TokensUsed}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
